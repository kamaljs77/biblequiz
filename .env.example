# --- Database (PostgreSQL) -------------------------------------------------
# Local development: any Postgres works, e.g. a local install or a separate
# free Supabase project for development.
# Supabase: Project → Connect → ORMs → Prisma shows both values.
#   DATABASE_URL = transaction pooler (port 6543) with ?pgbouncer=true
#   DIRECT_URL   = session pooler (port 5432), used by migrations
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/biblequiz"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/biblequiz"

# --- Admin sessions --------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- Admin account ---------------------------------------------------------
# Used by `npm run db:seed` (and `npm run prod:seed`) to create the single admin account.
ADMIN_EMAIL="admin@biblequiz.test"
ADMIN_PASSWORD=""
ADMIN_NAME="Kamal"

# --- Optional --------------------------------------------------------------
# Public address, for link previews. On Vercel it defaults to the production domain.
# SITE_URL="https://biblequiz.example.org"
